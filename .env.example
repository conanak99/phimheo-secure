# Local PostgreSQL (Docker)
POSTGRES_USER=onlyheo
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=onlyheo_secure
POSTGRES_PORT=5433
DATABASE_URL=postgresql://onlyheo:change_me_strong_db_password@127.0.0.1:5433/onlyheo_secure
DATABASE_SSL=false

# Deployment origin (set in production behind a reverse proxy for checkOrigin)
SITE_URL=http://localhost:4321
# Set to true only when testing a production build locally over plain HTTP
ALLOW_INSECURE_COOKIES=false

# Server-side secrets (generate with `openssl rand -hex 32`)
SESSION_SECRET=change_me_64_hex_chars
PAYMENT_SECRET=change_me_server_only_payment_secret

# Admin seed credentials (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@onlyheo.vn
SEED_ADMIN_PASSWORD=change_me_admin_password

# Cloudflare Turnstile
# Testing keys (always pass on localhost): https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Replace with real Cloudflare Turnstile sitekey & secret key in production
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
