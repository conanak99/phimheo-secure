---
import { eq } from 'drizzle-orm';
import { db } from '../db';
import { users } from '../db/schema';
import Layout from '../layouts/Layout.astro';
import { getPublicCommunityProfiles } from '../lib/queries';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?from=/profile');
}

let saved = Astro.url.searchParams.get('saved') === '1';
let error = '';
let bioValue = user.bio;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const bio = (formData.get('bio')?.toString() ?? '').trim();
  bioValue = bio;

  if (bio.length > 500) {
    error = 'Giới thiệu tối đa 500 ký tự.';
  } else {
    // Only update `bio` for the authenticated user; never allow role/premium changes.
    await db
      .update(users)
      .set({ bio })
      .where(eq(users.id, user.id));
    return Astro.redirect('/profile?saved=1');
  }
}

const profiles = await getPublicCommunityProfiles();
---

<Layout title="Hồ sơ · OnlyHeo">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="flex items-center gap-5">
      <div
        class="grid h-20 w-20 place-items-center rounded-2xl bg-gradient-to-br from-brand to-brandDeep text-3xl font-extrabold text-white"
      >
        {user.username.slice(0, 1).toUpperCase()}
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-brand">
          Hồ sơ của bạn
        </p>
        <h1 class="mt-1 text-3xl font-bold text-slate-900">{user.username}</h1>
        <p class="mt-1 text-sm text-slate-500">{user.email}</p>
      </div>
      <span
        class="ml-auto rounded-full border border-edge bg-white px-3 py-1 text-xs font-semibold text-slate-700"
      >
        {user.isPremium ? '★ Thành viên Heo VIP' : 'Thành viên miễn phí'}
      </span>
    </div>

    <div class="mt-10 grid gap-7 lg:grid-cols-[1fr_340px]">
      <form method="POST" action="/profile" class="card p-6">
        <h2 class="text-lg font-bold text-slate-900">Giới thiệu về bạn</h2>
        <p class="mt-1 text-sm text-slate-500">
          Đoạn này hiện ngay dưới tên bạn mỗi lần bạn bình luận.
        </p>
        <label for="bio" class="label mt-6"> Giới thiệu </label>
        <textarea
          id="bio"
          name="bio"
          class="input resize-none"
          rows={7}
          maxlength={500}
          placeholder="Công khai gu heo bí mật của bạn…">{bioValue}</textarea>

        <p class="mt-2 text-xs text-slate-600">
          Muốn viết gì thì viết nha, heo heo heo. (Văn bản thuần, tự động lọc
          XSS.)
        </p>
        {error && <p class="mt-2 text-xs text-red-600">{error}</p>}
        <button type="submit" class="btn-primary mt-5">
          {saved ? 'Đã lưu!' : 'Lưu hồ sơ'}
        </button>
      </form>

      <section class="card p-6">
        <h2 class="text-lg font-bold text-slate-900">Cộng đồng mê heo</h2>
        <p class="mt-1 text-xs text-slate-500">Thành viên mới tham gia</p>
        <div class="mt-5 space-y-4">
          {
            profiles.map((profile) => (
              <div class="border-b border-edge pb-4 last:border-0 last:pb-0">
                <div class="flex items-center gap-3">
                  <span class="grid h-8 w-8 place-items-center rounded-full bg-edge text-xs font-bold">
                    {profile.username.slice(0, 1).toUpperCase()}
                  </span>
                  <div>
                    <p class="text-sm font-semibold text-slate-900">
                      {profile.username}
                    </p>
                    <p class="text-[10px] text-slate-500">
                      Email được bảo vệ hoàn toàn trên máy chủ
                    </p>
                  </div>
                </div>
                <p class="mt-2 line-clamp-2 text-xs leading-5 text-slate-500">
                  {profile.bio}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
