---
import { eq } from 'drizzle-orm';
import TurnstileWidget from '../components/TurnstileWidget.astro';
import { db } from '../db';
import { users } from '../db/schema';
import Layout from '../layouts/Layout.astro';
import { logSecurityEvent } from '../lib/audit';
import { createSession, sanitizeReturnTo } from '../lib/auth';
import { parseFormData } from '../lib/http';
import {
  hashPassword,
  MAX_PASSWORD_LENGTH,
  MIN_PASSWORD_LENGTH,
  needsPasswordRehash,
  verifyPassword,
} from '../lib/password';
import { consumeRateLimit, getClientKey, resetRateLimit } from '../lib/rateLimit';
import { verifyTurnstileToken } from '../lib/turnstile';
import { loginSchema, registerSchema } from '../lib/validation';

const returnTo = sanitizeReturnTo(Astro.url.searchParams.get('from'), '/profile');

if (Astro.locals.user) {
  return Astro.redirect(returnTo);
}

let mode: 'login' | 'register' =
  Astro.url.searchParams.get('mode') === 'register' ? 'register' : 'login';
let error = '';
let emailValue = '';
let usernameValue = '';

if (Astro.request.method === 'POST') {
  const formData = await parseFormData(Astro.request);
  if (!formData) {
    Astro.response.status = 400;
    error = 'Yêu cầu biểu mẫu không hợp lệ.';
  } else {
    const submittedMode = formData.get('mode')?.toString();
    mode = submittedMode === 'register' ? 'register' : 'login';

    const submittedReturnTo = sanitizeReturnTo(
      formData.get('from')?.toString(),
      '/profile',
    );
    const rawEmail = (formData.get('email')?.toString() ?? '').trim().toLowerCase();
    const rawPassword = formData.get('password')?.toString() ?? '';
    const rawUsername = (formData.get('username')?.toString() ?? '').trim();

    emailValue = rawEmail.slice(0, 254);
    usernameValue = rawUsername.slice(0, 40);

    const clientIp = getClientKey(Astro.clientAddress);
    const turnstileToken = formData.get('cf-turnstile-response')?.toString();

    if (mode === 'login') {
      const ipLimit = await consumeRateLimit('loginIp', clientIp);
      const acctLimit = await consumeRateLimit(
        'loginAccount',
        `${clientIp}:${emailValue}`,
      );

      if (!ipLimit.allowed || !acctLimit.allowed) {
        const retryAfter = Math.max(
          ipLimit.retryAfterSeconds,
          acctLimit.retryAfterSeconds,
        );
        Astro.response.status = 429;
        Astro.response.headers.set('Retry-After', String(retryAfter));
        logSecurityEvent('auth.rate_limited', {
          route: '/login',
          mode: 'login',
          ip: clientIp,
        });
        error = `Quá nhiều lần thử đăng nhập. Vui lòng thử lại sau ${retryAfter} giây.`;
      } else {
        const turnstile = await verifyTurnstileToken({
          token: turnstileToken,
          remoteIp: clientIp,
          expectedAction: 'login',
        });

        if (!turnstile.success) {
          Astro.response.status = 403;
          error = 'Xác minh chống bot (Turnstile) không thành công. Vui lòng thử lại.';
        } else {
          const parsed = loginSchema.safeParse({
            email: rawEmail,
            password: rawPassword,
          });

          if (!parsed.success) {
            error = 'Email hoặc mật khẩu không chính xác.';
          } else {
            const { email, password } = parsed.data;
            const [existing] = await db
              .select()
              .from(users)
              .where(eq(users.email, email))
              .limit(1);

            // Always invoke verifyPassword (even when existing is undefined) to equalize timing
            const valid = await verifyPassword(
              password,
              existing?.passwordHash ?? null,
            );

            if (!valid || !existing) {
              logSecurityEvent('auth.login_failed', {
                ip: clientIp,
                userExists: Boolean(existing),
              });
              error = 'Email hoặc mật khẩu không chính xác.';
            } else {
              if (needsPasswordRehash(existing.passwordHash)) {
                const upgradedHash = await hashPassword(password);
                await db
                  .update(users)
                  .set({ passwordHash: upgradedHash })
                  .where(eq(users.id, existing.id));
              }
              await resetRateLimit('loginAccount', `${clientIp}:${emailValue}`);
              await createSession(existing.id, Astro.cookies, Astro.url);
              logSecurityEvent('auth.login_success', {
                userId: existing.id,
                ip: clientIp,
              });
              return Astro.redirect(submittedReturnTo);
            }
          }
        }
      }
    } else {
      const regLimit = await consumeRateLimit('registerIp', clientIp);
      if (!regLimit.allowed) {
        Astro.response.status = 429;
        Astro.response.headers.set(
          'Retry-After',
          String(regLimit.retryAfterSeconds),
        );
        logSecurityEvent('auth.rate_limited', {
          route: '/login',
          mode: 'register',
          ip: clientIp,
        });
        error = `Quá nhiều lượt đăng ký. Vui lòng thử lại sau ${regLimit.retryAfterSeconds} giây.`;
      } else {
        const turnstile = await verifyTurnstileToken({
          token: turnstileToken,
          remoteIp: clientIp,
          expectedAction: 'register',
        });

        if (!turnstile.success) {
          Astro.response.status = 403;
          error = 'Xác minh chống bot (Turnstile) không thành công. Vui lòng thử lại.';
        } else {
          const parsed = registerSchema.safeParse({
            username: rawUsername,
            email: rawEmail,
            password: rawPassword,
          });

          if (!parsed.success) {
            error =
              parsed.error.issues[0]?.message ?? 'Thông tin đăng ký không hợp lệ.';
          } else {
            const { username, email, password } = parsed.data;
            const [duplicate] = await db
              .select({ id: users.id })
              .from(users)
              .where(eq(users.email, email))
              .limit(1);

            if (duplicate) {
              // Avoid leaking whether an email is registered
              logSecurityEvent('auth.register_conflict', { ip: clientIp });
              error =
                'Không thể tạo tài khoản với thông tin này. Vui lòng kiểm tra lại hoặc đăng nhập.';
            } else {
              const passwordHash = await hashPassword(password);
              const [created] = await db
                .insert(users)
                .values({
                  username,
                  email,
                  passwordHash,
                  bio: '',
                  isPremium: false,
                  isAdmin: false,
                })
                .returning({ id: users.id });

              if (created) {
                await createSession(created.id, Astro.cookies, Astro.url);
                logSecurityEvent('auth.register_success', {
                  userId: created.id,
                  ip: clientIp,
                });
                return Astro.redirect(submittedReturnTo);
              }
              error = 'Không thể tạo tài khoản.';
            }
          }
        }
      }
    }
  }
}

const fromQuery = returnTo !== '/profile' ? `&from=${encodeURIComponent(returnTo)}` : '';
---

<Layout
  title={mode === 'login' ? 'Đăng nhập · OnlyHeo' : 'Đăng ký · OnlyHeo'}
  loadTurnstile={true}
>
  <div class="mx-auto grid min-h-[72vh] max-w-5xl place-items-center px-4 py-14">
    <div
      class="grid w-full overflow-hidden rounded-2xl border border-edge bg-panel shadow-2xl md:grid-cols-2"
    >
      <div
        class="hidden bg-gradient-to-br from-[#00aff0] via-[#39c2f5] to-[#ff91bb] p-10 md:flex md:flex-col md:justify-between"
      >
        <div class="text-7xl">🐷</div>
        <div>
          <h2 class="text-3xl font-extrabold text-white">
            Các bé heo đang nằm chờ.
          </h2>
          <p class="mt-3 leading-7 text-white/90">
            Đăng nhập để xem heo không che… watermark. Bé nào cũng đã sẵn sàng,
            chỉ chờ bạn bấm play.
          </p>
        </div>
      </div>

      <div class="p-7 sm:p-10">
        <p class="text-xs font-bold uppercase tracking-widest text-brand">
          Tài khoản OnlyHeo
        </p>
        <h1 class="mt-2 text-3xl font-bold text-slate-900">
          {mode === 'login' ? 'Chào mừng trở lại' : 'Tạo tài khoản mới'}
        </h1>

        <div class="mt-6 flex rounded-lg bg-ink p-1">
          <a
            href={`/login?mode=login${fromQuery}`}
            class={`flex-1 rounded-md py-2 text-center text-sm font-semibold ${
              mode === 'login'
                ? 'bg-white text-brand shadow-sm'
                : 'text-slate-500'
            }`}
          >
            Đăng nhập
          </a>
          <a
            href={`/login?mode=register${fromQuery}`}
            class={`flex-1 rounded-md py-2 text-center text-sm font-semibold ${
              mode === 'register'
                ? 'bg-white text-brand shadow-sm'
                : 'text-slate-500'
            }`}
          >
            Đăng ký
          </a>
        </div>

        <form method="POST" action="/login" class="mt-6 space-y-4">
          <input type="hidden" name="mode" value={mode} />
          <input type="hidden" name="from" value={returnTo} />
          {
            mode === 'register' && (
              <div>
                <label for="username" class="label">
                  Tên người dùng
                </label>
                <input
                  id="username"
                  name="username"
                  class="input"
                  value={usernameValue}
                  minlength={2}
                  maxlength={40}
                  required
                />
              </div>
            )
          }
          <div>
            <label for="email" class="label"> Email </label>
            <input
              id="email"
              name="email"
              type="email"
              class="input"
              value={emailValue}
              maxlength={254}
              autocomplete="email"
              required
            />
          </div>
          <div>
            <label for="password" class="label"> Mật khẩu </label>
            <input
              id="password"
              name="password"
              type="password"
              class="input"
              autocomplete={mode === 'login' ? 'current-password' : 'new-password'}
              minlength={mode === 'register' ? MIN_PASSWORD_LENGTH : 1}
              maxlength={MAX_PASSWORD_LENGTH}
              required
            />
          </div>
          <TurnstileWidget action={mode} />
          {
            error && (
              <p class="rounded-lg bg-red-50 p-3 text-sm text-red-600">
                {error}
              </p>
            )
          }
          <button type="submit" class="btn-primary w-full py-3">
            {mode === 'login' ? 'Đăng nhập' : 'Tạo tài khoản'}
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
