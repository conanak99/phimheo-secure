---
import crypto from 'node:crypto';
import { and, eq } from 'drizzle-orm';
import TurnstileWidget from '../components/TurnstileWidget.astro';
import { db } from '../db';
import { payments } from '../db/schema';
import Layout from '../layouts/Layout.astro';
import { logSecurityEvent } from '../lib/audit';
import { parseFormData } from '../lib/http';
import { getLatestPendingPaymentForUser } from '../lib/queries';
import { consumeRateLimit, getClientKey } from '../lib/rateLimit';
import { verifyTurnstileToken } from '../lib/turnstile';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?from=/checkout');
}

const VIP_AMOUNT_VND = 169000;

// Entitlement is strictly derived from server DB state (never query params)
const complete = user.isPremium;
let paymentError = '';

if (Astro.request.method === 'POST' && !user.isPremium) {
  const formData = await parseFormData(Astro.request);
  if (!formData) {
    Astro.response.status = 400;
    paymentError = 'Yêu cầu thanh toán không hợp lệ.';
  } else {
    const rate = await consumeRateLimit('checkoutUser', user.id);
    if (!rate.allowed) {
      Astro.response.status = 429;
      Astro.response.headers.set('Retry-After', String(rate.retryAfterSeconds));
      logSecurityEvent('auth.rate_limited', {
        route: '/checkout',
        userId: user.id,
      });
      paymentError = `Quá nhiều yêu cầu thanh toán. Vui lòng thử lại sau ${rate.retryAfterSeconds} giây.`;
    } else {
      const turnstile = await verifyTurnstileToken({
        token: formData.get('cf-turnstile-response')?.toString(),
        remoteIp: getClientKey(Astro.clientAddress),
        expectedAction: 'checkout',
      });

      if (!turnstile.success) {
        Astro.response.status = 403;
        paymentError =
          'Xác minh chống bot (Turnstile) không thành công. Vui lòng thử lại.';
      } else {
        const paymentSecret = process.env.PAYMENT_SECRET;
        if (!paymentSecret || paymentSecret.length < 24) {
          throw new Error(
            'PAYMENT_SECRET must be set and at least 24 characters long',
          );
        }

        // Reuse an existing pending order for this user or create a new pending payment intent.
        // Raw PAN/CVC are never accepted by this server; entitlement is granted ONLY when
        // POST /api/payments/webhook receives a cryptographically signed provider confirmation.
        const existingPending = await db
          .select({ id: payments.id })
          .from(payments)
          .where(
            and(eq(payments.userId, user.id), eq(payments.status, 'pending')),
          )
          .limit(1);

        if (!existingPending[0]) {
          const intentNonce = crypto.randomBytes(16).toString('hex');
          const receiptSignature = crypto
            .createHmac('sha256', paymentSecret)
            .update(`${user.id}:${VIP_AMOUNT_VND}:${intentNonce}`)
            .digest('hex');

          const [created] = await db
            .insert(payments)
            .values({
              userId: user.id,
              amountVnd: VIP_AMOUNT_VND,
              cardLast4: 'hosted',
              receiptSignature,
              status: 'pending',
            })
            .returning({ id: payments.id });

          if (created) {
            logSecurityEvent('payment.intent_created', {
              userId: user.id,
              paymentId: created.id,
              amountVnd: VIP_AMOUNT_VND,
            });
          }
        }

        return Astro.redirect('/checkout');
      }
    }
  }
}

const latestPayment = !complete
  ? await getLatestPendingPaymentForUser(user.id)
  : undefined;
const pendingPayment =
  latestPayment?.status === 'pending' ? latestPayment : undefined;

const benefits = [
  'Toàn bộ video độc quyền, kèm bản dựng của đạo diễn',
  'Xem 4K, nếu máy bạn chịu được',
  'Không quảng cáo, chỉ có heo nằm quảng ra',
];
---

<Layout
  title="Nâng cấp Heo VIP · OnlyHeo"
  loadTurnstile={!complete && !pendingPayment}
>
  {
    complete ? (
      <div class="mx-auto grid min-h-[65vh] max-w-xl place-items-center px-4 text-center">
        <div class="card w-full p-10">
          <span class="text-6xl">🎉</span>
          <h1 class="mt-5 text-3xl font-bold text-slate-900">
            Đã mở khóa Heo VIP
          </h1>
          <p class="mt-3 text-slate-600">
            Quyền Heo VIP của tài khoản đã được xác thực phía máy chủ.
          </p>
          <a href="/" class="btn-primary mt-7">
            Xem phim Heo VIP
          </a>
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-[1fr_400px]">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-brand">
              OnlyHeo VIP
            </p>
            <h1 class="mt-3 text-4xl font-extrabold text-slate-900">
              Mở khóa toàn bộ thân hình tròn trịa.
            </h1>
            <p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">
              Bụng hồng không rỗ pixel, mũi ướt quay 4K. Mỗi tuần thêm heo mới,
              bé nào cũng chiều bạn tới khung hình cuối.
            </p>
            <ul class="mt-8 space-y-4 text-sm text-slate-700">
              {benefits.map((benefit) => (
                <li class="flex items-center gap-3">
                  <span class="grid h-6 w-6 place-items-center rounded-full bg-brand/15 text-brand">
                    ✓
                  </span>
                  {benefit}
                </li>
              ))}
            </ul>
          </div>

          <div class="card p-6">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-sm font-semibold text-slate-900">
                  Heo VIP hàng tháng
                </p>
                <p class="mt-1 text-xs text-slate-500">Hủy bất cứ lúc nào</p>
              </div>
              <p class="text-2xl font-bold text-slate-900">
                169K
                <span class="text-sm font-normal text-slate-500">/tháng</span>
              </p>
            </div>
            <div class="my-6 border-t border-edge" />

            {pendingPayment ? (
              <div class="space-y-4">
                <div class="rounded-lg border border-brand/30 bg-brand/5 p-4">
                  <p class="text-xs font-bold uppercase tracking-wider text-brand">
                    Đơn thanh toán đang chờ xác nhận
                  </p>
                  <p class="mt-2 text-xs text-slate-600">
                    Mã đơn hàng:
                  </p>
                  <p class="mt-1 break-all font-mono text-xs text-slate-900">
                    {pendingPayment.id}
                  </p>
                  <p class="mt-3 text-xs leading-5 text-slate-600">
                    Quyền Heo VIP chỉ được kích hoạt sau khi cổng thanh toán gửi
                    webhook có chữ ký HMAC hợp lệ tới{' '}
                    <code class="font-mono text-slate-800">
                      POST /api/payments/webhook
                    </code>
                    .
                  </p>
                </div>
                <a href="/checkout" class="btn-ghost w-full py-2.5 text-center">
                  Kiểm tra trạng thái thanh toán
                </a>
              </div>
            ) : (
              <form method="POST" action="/checkout" class="space-y-4">
                <p class="text-xs leading-5 text-slate-600">
                  Máy chủ không bao giờ thu thập trực tiếp số thẻ hoặc mã CVC
                  (tuân thủ phạm vi PCI-DSS). Bấm nút bên dưới để tạo đơn thanh
                  toán ở trạng thái chờ xác thực từ cổng thanh toán.
                </p>
                <TurnstileWidget action="checkout" />
                {paymentError && (
                  <p class="rounded-lg bg-red-50 p-3 text-sm text-red-600">
                    {paymentError}
                  </p>
                )}
                <button type="submit" class="btn-primary w-full py-3">
                  Tạo đơn thanh toán Heo VIP
                </button>
              </form>
            )}

            <p class="mt-4 text-center text-[10px] leading-4 text-slate-600">
              Cấp quyền độc quyền qua webhook ký HMAC-SHA256 phía máy chủ
            </p>
          </div>
        </div>
      </div>
    )
  }
</Layout>
