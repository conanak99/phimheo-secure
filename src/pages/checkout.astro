---
import crypto from 'node:crypto';
import { eq } from 'drizzle-orm';
import { db } from '../db';
import { payments, users } from '../db/schema';
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?from=/checkout');
}

let complete = user.isPremium || Astro.url.searchParams.get('complete') === '1';
let paymentError = '';
let cardNumber = '4242 4242 4242 4242';
let expiry = '12/30';
let cvc = '123';

if (Astro.request.method === 'POST' && !user.isPremium) {
  const formData = await Astro.request.formData();
  cardNumber = (formData.get('cardNumber')?.toString() ?? '').trim();
  expiry = (formData.get('expiry')?.toString() ?? '').trim();
  cvc = (formData.get('cvc')?.toString() ?? '').trim();

  const cardDigits = cardNumber.replace(/\s/g, '');
  if (!/^\d{16}$/.test(cardDigits)) {
    paymentError = 'Số thẻ phải gồm 16 chữ số.';
  } else if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expiry)) {
    paymentError = 'Ngày hết hạn phải có dạng MM/YY.';
  } else if (!/^\d{3,4}$/.test(cvc)) {
    paymentError = 'CVC phải gồm 3 hoặc 4 chữ số.';
  } else {
    // Server-side payment verification & entitlement grant using server-only PAYMENT_SECRET
    const paymentSecret = process.env.PAYMENT_SECRET;
    if (!paymentSecret) {
      throw new Error('PAYMENT_SECRET environment variable is required');
    }

    const amountVnd = 169000;
    const cardLast4 = cardDigits.slice(-4);
    const receiptSignature = crypto
      .createHmac('sha256', paymentSecret)
      .update(`${user.id}:${amountVnd}:${cardLast4}:${Date.now()}`)
      .digest('hex');

    await db.transaction(async (tx) => {
      await tx.insert(payments).values({
        userId: user.id,
        amountVnd,
        cardLast4,
        receiptSignature,
        status: 'paid',
      });
      await tx
        .update(users)
        .set({ isPremium: true })
        .where(eq(users.id, user.id));
    });

    return Astro.redirect('/checkout?complete=1');
  }
}

const benefits = [
  'Toàn bộ video độc quyền, kèm bản dựng của đạo diễn',
  'Xem 4K, nếu máy bạn chịu được',
  'Không quảng cáo, chỉ có heo nằm quảng ra',
];
---

<Layout title="Nâng cấp Heo VIP · OnlyHeo">
  {
    complete ? (
      <div class="mx-auto grid min-h-[65vh] max-w-xl place-items-center px-4 text-center">
        <div class="card w-full p-10">
          <span class="text-6xl">🎉</span>
          <h1 class="mt-5 text-3xl font-bold text-slate-900">
            Đã mở khóa Heo VIP
          </h1>
          <p class="mt-3 text-slate-600">
            Thanh toán đã được xác thực phía máy chủ và cấp quyền thành công.
          </p>
          <a href="/" class="btn-primary mt-7">
            Xem phim Heo VIP
          </a>
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-[1fr_380px]">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-brand">
              OnlyHeo VIP
            </p>
            <h1 class="mt-3 text-4xl font-extrabold text-slate-900">
              Mở khóa toàn bộ thân hình tròn trịa.
            </h1>
            <p class="mt-4 max-w-xl text-lg leading-8 text-slate-600">
              Bụng hồng không rỗ pixel, mũi ướt quay 4K. Mỗi tuần thêm heo mới,
              bé nào cũng chiều bạn tới khung hình cuối.
            </p>
            <ul class="mt-8 space-y-4 text-sm text-slate-700">
              {benefits.map((benefit) => (
                <li class="flex items-center gap-3">
                  <span class="grid h-6 w-6 place-items-center rounded-full bg-brand/15 text-brand">
                    ✓
                  </span>
                  {benefit}
                </li>
              ))}
            </ul>
          </div>

          <form method="POST" action="/checkout" class="card p-6">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-sm font-semibold text-slate-900">
                  Heo VIP hàng tháng
                </p>
                <p class="mt-1 text-xs text-slate-500">Hủy bất cứ lúc nào</p>
              </div>
              <p class="text-2xl font-bold text-slate-900">
                169K
                <span class="text-sm font-normal text-slate-500">/tháng</span>
              </p>
            </div>
            <div class="my-6 border-t border-edge" />
            <div>
              <label for="card" class="label">
                Số thẻ
              </label>
              <input
                id="card"
                name="cardNumber"
                class="input"
                value={cardNumber}
                inputmode="numeric"
                autocomplete="cc-number"
                maxlength={19}
                required
              />
            </div>
            <div class="mt-4 grid grid-cols-2 gap-3">
              <div>
                <label for="expiry" class="label">
                  Hết hạn
                </label>
                <input
                  id="expiry"
                  name="expiry"
                  class="input"
                  value={expiry}
                  inputmode="numeric"
                  autocomplete="cc-exp"
                  placeholder="MM/YY"
                  maxlength={5}
                  required
                />
              </div>
              <div>
                <label for="cvc" class="label">
                  CVC
                </label>
                <input
                  id="cvc"
                  name="cvc"
                  class="input"
                  value={cvc}
                  inputmode="numeric"
                  autocomplete="cc-csc"
                  maxlength={4}
                  required
                />
              </div>
            </div>
            {paymentError && (
              <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-600">
                {paymentError}
              </p>
            )}
            <button type="submit" class="btn-primary mt-6 w-full py-3">
              Bắt đầu trải nghiệm Heo VIP
            </button>
            <p class="mt-4 text-center text-[10px] leading-4 text-slate-600">
              Môi trường demo · Xác thực thanh toán phía máy chủ
            </p>
          </form>
        </div>
      </div>
    )
  }
</Layout>
