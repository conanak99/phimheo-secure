---
import VideoCard from '../components/VideoCard.astro';
import Layout from '../layouts/Layout.astro';
import { getPremiumVideos } from '../lib/queries';

const user = Astro.locals.user;
const videos = await getPremiumVideos();
const premiumUser = Boolean(user?.isPremium || user?.isAdmin);
---

<Layout title="Heo VIP · OnlyHeo">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <section
      class="overflow-hidden rounded-2xl border border-brand/20 bg-gradient-to-br from-brand/15 via-panel to-panel p-8 sm:p-12"
    >
      <p class="text-xs font-bold uppercase tracking-widest text-brand">
        OnlyHeo VIP
      </p>
      <h1
        class="mt-3 max-w-2xl text-4xl font-extrabold text-slate-900 sm:text-5xl"
      >
        Nội dung 18+: hơn 18 chú heo đang đợi bạn.
      </h1>
      <p class="mt-4 max-w-2xl leading-7 text-slate-600">
        Heo không che, không làm mờ. Từng nếp da hồng và chiếc bụng tròn, tất cả
        ở 4K.
      </p>
      {
        !premiumUser && (
          <a href="/checkout" class="btn-primary mt-7 px-6 py-3">
            Nâng cấp Heo VIP
          </a>
        )
      }
    </section>

    <div class="mt-12 flex items-end justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-brand">
          Kho thành viên
        </p>
        <h2 class="mt-2 text-3xl font-bold text-slate-900">Phim Heo VIP</h2>
      </div>
      <span class="text-sm text-slate-500">{videos.length} video</span>
    </div>

    <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        videos.map((video) => (
          <VideoCard video={video} premiumUser={premiumUser} />
        ))
      }
    </div>
  </div>
</Layout>
